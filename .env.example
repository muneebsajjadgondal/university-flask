# Leave unset to use a local SQLite file (app.db) for zero-config development.
# For production, point this at a real Postgres database.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Long random string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace-with-a-long-random-string"

# Optional: SMTP settings for password-reset emails. If left unset, reset
# links are logged to the server console instead — the "forgot password"
# flow still works fully without these, which is useful for local dev and
# quick demos. Set these for real email delivery in production.
MAIL_SERVER=""
MAIL_PORT="587"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_USE_TLS="true"
MAIL_DEFAULT_SENDER="registrar@university.edu"
